{
  "name": "dsh2vs",
  "version": "0.1.0",
  "description": "DSH plugin: connect the dsh2vs bridge to build and debug Visual Studio C++ projects (MSBuild + cdb) without a VSIX or a running Visual Studio.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "mcpName": "io.github.aaalzk/dsh2vs",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "visual-studio",
    "cpp",
    "msbuild",
    "cdb",
    "debugger"
  ],
  "homepage": "https://github.com/aaalzk/dsh2vs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaalzk/dsh2vs.git"
  },
  "bugs": {
    "url": "https://github.com/aaalzk/dsh2vs/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
